# Unreal packages remain binary and are stored through Git LFS.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
# Audio: third-party CC0 sound sources are binary as well.
*.ogg filter=lfs diff=lfs merge=lfs -text
# Audio: original music tracks supplied by the project owner (#94).
/SourceData/Audio/Music/*.mp3 filter=lfs diff=lfs merge=lfs -text
# Audio: original combat sounds rendered by SourceData/Audio/Lockdown/synth_demo_audio.py.
/SourceData/Audio/Lockdown/*.wav filter=lfs diff=lfs merge=lfs -text
# Audio: CC BY 4.0 layers (Free Modular Magic SFX) and the mixes of SourceData/Audio/Layered/build_layered_audio.py.
/SourceData/Audio/FabMagic/*.wav filter=lfs diff=lfs merge=lfs -text
/SourceData/Audio/Layered/*.wav filter=lfs diff=lfs merge=lfs -text
# Art: third-party CC0 model and texture sources are binary or embed binary buffers.
/SourceData/Art/**/*.gltf filter=lfs diff=lfs merge=lfs -text
/SourceData/Art/**/*.glb filter=lfs diff=lfs merge=lfs -text
/SourceData/Art/**/*.bin filter=lfs diff=lfs merge=lfs -text
/SourceData/Art/**/*.png filter=lfs diff=lfs merge=lfs -text
# UI: full-screen background images supplied by the project owner.
/SourceData/UI/*.png filter=lfs diff=lfs merge=lfs -text
# UI: skill, passive, attribute, opening and status icons generated for this project (#85).
/SourceData/UI/Icons/*.png filter=lfs diff=lfs merge=lfs -text
# UI: Source Han Sans SC (SIL OFL 1.1) faces for the interface typography.
/SourceData/UI/Fonts/*.otf filter=lfs diff=lfs merge=lfs -text
/SourceData/UI/Fonts/*.ttf filter=lfs diff=lfs merge=lfs -text
# VFX: hit-effect masks rendered by SourceData/VFX/Blender/hit_textures.py.
/SourceData/VFX/*.png filter=lfs diff=lfs merge=lfs -text

# Docs: visual evidence for the VFX manual (approved and rejected references).
/docs/systems/vfx/** filter=lfs diff=lfs merge=lfs -text

# Human-readable documentation uses one portable text format.
*.md text eol=lf

# These inputs and payloads participate in native content signatures.
/SourceData/** -text
/Content/Lockdown/Data/Demo/*.json -text
/Source/Lockdown/Private/World/LDDemoWorldContract.h -text
/Source/Lockdown/Private/Development/LDDemoContentContract.h -text
/Source/Lockdown/Public/Development/LDDemoContentIds.h -text
