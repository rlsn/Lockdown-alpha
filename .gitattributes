# Store Unreal binary packages through Git LFS as content is added.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

# Generated package signatures hash this layout text; keep checkout bytes stable.
/Config/BootstrapLayout.json text eol=lf

# Supplied discussion copies have published byte hashes; preserve their bytes.
/docs/v06/reference-discussion/0*_ASSISTANT_MESSAGE.txt -text -whitespace
