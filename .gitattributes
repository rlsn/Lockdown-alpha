# Unreal packages remain binary and are stored through Git LFS.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

# Human-readable documentation uses one portable text format.
*.md text eol=lf

# These inputs and payloads participate in native content signatures.
/Config/BootstrapLayout.json text eol=lf
/SourceData/** -text
/Content/Lockdown/Data/V07/*.json text eol=lf
/Content/Lockdown/Data/V08/*.json -text
/Content/Lockdown/Data/V09/*.json -text
