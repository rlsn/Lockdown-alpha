    },
    {
      "description_key": "item_runic_focus.description",
      "description_text": "提高缺德值和鬼点子。",
      "icon_id": "icon_item_runic_focus",
      "id": "item_runic_focus",
      "name_key": "item_runic_focus.name",
      "name_text": "辣条",
      "namespace": "DemoContent"
    },
    {
      "description_key": "item_siphon_emblem.description",
      "description_text": "提高手劲和脸皮。被动「长脸」：弹脑瓜崩让对方实际丢掉的面子，按比例回到自己身上。",
      "icon_id": "icon_item_siphon_emblem",
