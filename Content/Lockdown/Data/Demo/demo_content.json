      "id": "active_arc_bolt",
      "name_key": "active_arc_bolt.name",
      "name_text": "粉笔头",
      "namespace": "DemoContent"
    },
    {
      "description_key": "active_binding_snare.description",
      "description_text": "对一名看得见的敌人造成社死伤害并让其定身。伤害随缺德值提高，不会正中要害。",
      "icon_id": "icon_active_binding_snare",
      "id": "active_binding_snare",
      "name_key": "active_binding_snare.name",
      "name_text": "扒裤衩",
      "namespace": "DemoContent"
    },
    {
      "description_key": "active_guard_pulse.description",
      "description_text": "给自己加上淡定，并立刻解除身上所有定身。淡定量随缺德值提高。",
      "icon_id": "icon_active_guard_pulse",
      "id": "active_guard_pulse",
      "name_key": "active_guard_pulse.name",
      "name_text": "假装无事发生",
      "namespace": "DemoContent"
    },
