      "description_key": "item_phase_anchor.description",
      "description_text": "提高腿速。主动「冲刺」：朝指定方向冲出一段距离，碰到阻挡就停下；被定身时不能冲刺。",
      "icon_id": "icon_item_phase_anchor",
      "id": "item_phase_anchor",
      "name_key": "item_phase_anchor.name",
      "name_text": "跑道钉鞋",
