      "name_key": "item_siphon_emblem.name",
      "name_text": "老爸的皮带",
      "namespace": "DemoContent"
    },
    {
      "description_key": "monster_guardian.description",
      "description_text": "高档野怪，更耐打、出手更重。不会主动出手，被打后反击；追得太远就回岗。",
      "icon_id": "icon_monster_guardian",
      "id": "monster_guardian",
      "name_key": "monster_guardian.name",
      "name_text": "体育老师",
      "namespace": "DemoContent"
    },
    {
      "description_key": "monster_scavenger.description",
      "description_text": "低档野怪。不会主动出手，被打后同组一起反击；追得太远就回岗。",
      "icon_id": "icon_monster_scavenger",
      "id": "monster_scavenger",
      "name_key": "monster_scavenger.name",
      "name_text": "纪律委员",
      "namespace": "DemoContent"
    },
    {
      "description_key": "passive_battle_rhythm.description",
      "description_text": "学会后持续提高手速。",
      "icon_id": "icon_passive_battle_rhythm",
      "id": "passive_battle_rhythm",
      "name_key": "passive_battle_rhythm.name",
      "name_text": "单身二十年的手速",
      "namespace": "DemoContent"
    },
    {
      "description_key": "passive_precision.description",
      "description_text": "学会后提高弹脑瓜崩的正中要害率，对技能无效。",
      "icon_id": "icon_passive_precision",
      "id": "passive_precision",
      "name_key": "passive_precision.name",
      "name_text": "正中要害",
      "namespace": "DemoContent"
    },
    {
      "description_key": "passive_second_wind.description",
      "description_text": "脱离战斗一段时间后，额外提高面子回复；一进入战斗，额外回复立刻停止。",
      "icon_id": "icon_passive_second_wind",
      "id": "passive_second_wind",
      "name_key": "passive_second_wind.name",
      "name_text": "多喝热水",
      "namespace": "DemoContent"
    },
    {
      "description_key": "respawn_protection.description",
      "description_text": "刚回到场上，暂时不受伤害和控制；一旦出手立刻解除。保护期间不能争夺升旗台。",
      "icon_id": "icon_respawn_protection",
      "id": "respawn_protection",
      "name_key": "respawn_protection.name",
      "name_text": "复活保护",
      "namespace": "DemoContent"
    },
    {
      "description_key": "root.description",
      "description_text": "不能移动和冲刺，但仍可以弹脑瓜崩、放技能和用装备。",
