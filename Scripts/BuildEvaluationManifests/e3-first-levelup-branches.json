{
  "schema": "build_evaluation.manifest",
  "schema_version": 2,
  "experiment": {
    "id": "e3-first-levelup-branches",
    "hypothesis": "同一前缀下，首个升级主动技能三选一（3 级机会，序号 2）的三个合法选项会改变固定策略中心点对决的结果。"
  },
  "adapter": {
    "module": "BuildEvaluationLockdown",
    "id": "lockdown-demo"
  },
  "scenario": {
    "kind": "duel_site",
    "parameters": {
      "site": "capture",
      "duel_timeout_ms": 45000,
      "supply_xp": {
        "subject": 440,
        "opponent": 440
      }
    }
  },
  "sample_class": "legal_search",
  "assumptions": [
    "两名对决者在 T=0 各获得 440 XP 供给（升到 5 级，共 2 次主动选择机会：开局 + 3 级），经正常奖励复合事务提交；这是供给假设，不证明真实对局能在同样时间拿到。",
    "候选由原生抽卡按 Case 种子真实抽出；分支点以外的选择与参考对手的全部选择都用生产 AI 选择规则。",
    "双方用同一个固定评估画像在中心点对决，交战微操是生产 AI 的 Engage。"
  ],
  "design": {
    "kind": "decision",
    "arms": [
      {
        "id": "option_0",
        "plan": {
          "subject": {
            "choices": [
              "ai_select",
              {
                "rule": "option_index",
                "index": 0
              }
            ]
          },
          "opponent": {
            "choices": [
              "ai_select",
              "ai_select"
            ]
          }
        }
      },
      {
        "id": "option_1",
        "plan": {
          "subject": {
            "choices": [
              "ai_select",
              {
                "rule": "option_index",
                "index": 1
              }
            ]
          },
          "opponent": {
            "choices": [
              "ai_select",
              "ai_select"
            ]
          }
        }
      },
      {
        "id": "option_2",
        "plan": {
          "subject": {
            "choices": [
              "ai_select",
              {
                "rule": "option_index",
                "index": 2
              }
            ]
          },
          "opponent": {
            "choices": [
              "ai_select",
              "ai_select"
            ]
          }
        }
      }
    ]
  },
  "blocks": {
    "root_seed": "20261109",
    "splits": {
      "search": 2,
      "confirm": 4
    },
    "sides": 2
  },
  "metrics": {
    "primary": "duel_score",
    "secondary": [
      "damage_dealt_hp",
      "damage_taken_hp",
      "subject_hp_end_bp",
      "decision_time_ms"
    ],
    "material_difference": null
  },
  "budget": {
    "class": "standard",
    "max_cases": 36,
    "case_wall_timeout_s": 180,
    "run_wall_timeout_s": 2400,
    "max_case_events": 200000,
    "max_run_disk_bytes": 2147483648,
    "max_root_disk_bytes": 6442450944
  }
