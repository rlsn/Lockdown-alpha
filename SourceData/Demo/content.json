  "display": [
    {"id": "character_demo", "namespace": "DemoContent", "name_key": "character_demo.name", "name_text": "脆皮大学生", "description_key": "character_demo.description", "description_text": "已成年，一碰就碎但嘴很硬。开局只会普攻；升级攒属性点、挑技能、捡构件。", "icon_id": "icon_character_demo", "portrait_icon_id": "portrait_character_demo"},
    {"id": "active_elbow", "namespace": "DemoContent", "name_key": "active_elbow.name", "name_text": "滚远点", "description_key": "active_elbow.description", "description_text": "把目标踹飞 [knockback.distance] 厘米，造成 [damage.amount] 物理伤害。", "icon_id": "icon_active_elbow"},
    {"id": "active_pants_down", "namespace": "DemoContent", "name_key": "active_pants_down.name", "name_text": "扒裤子", "description_key": "active_pants_down.description", "description_text": "定身目标 [root.duration] 秒，造成 [damage.amount] 物理伤害。", "icon_id": "icon_active_pants_down"},
    {"id": "active_crotch_grab", "namespace": "DemoContent", "name_key": "active_crotch_grab.name", "name_text": "掏蛋子", "description_key": "active_crotch_grab.description", "description_text": "眩晕目标 [stun.duration] 秒，造成 [damage.amount] 物理伤害。", "icon_id": "icon_active_crotch_grab"},
    {"id": "active_account_banned", "namespace": "DemoContent", "name_key": "active_account_banned.name", "name_text": "给老子闭嘴", "description_key": "active_account_banned.description", "description_text": "沉默目标 [silence.duration] 秒，造成 [damage.amount] 魔法伤害。", "icon_id": "icon_active_account_banned"},
    {"id": "active_unplug", "namespace": "DemoContent", "name_key": "active_unplug.name", "name_text": "拧你手腕", "description_key": "active_unplug.description", "description_text": "缴械目标 [disarm.duration] 秒，造成 [damage.amount] 物理伤害。", "icon_id": "icon_active_unplug"},
    {"id": "active_snark_bolt", "namespace": "DemoContent", "name_key": "active_snark_bolt.name", "name_text": "甩你一鞋", "description_key": "active_snark_bolt.description", "description_text": "直线甩鞋，首个敌人受 [damage.amount] 魔法伤害并减速 [slow.ratio]%，[slow.duration] 秒。", "icon_id": "icon_active_snark_bolt"},
    {"id": "active_seethe", "namespace": "DemoContent", "name_key": "active_seethe.name", "name_text": "烫你屁股", "description_key": "active_seethe.description", "description_text": "对身边敌人造成 [damage.amount] 魔法伤害和 [burn.count] 层灼烧。", "icon_id": "icon_active_seethe"},
    {"id": "active_quick_meeting", "namespace": "DemoContent", "name_key": "active_quick_meeting.name", "name_text": "脚底开锅", "description_key": "active_quick_meeting.description", "description_text": "原地开锅 [zone.duration] 秒，每秒一跳：[zone_damage.amount] 魔法伤害、[zone_burn.count] 层灼烧、减速 [zone_slow.ratio]%。", "icon_id": "icon_active_quick_meeting"},
    {"id": "active_bail_out", "namespace": "DemoContent", "name_key": "active_bail_out.name", "name_text": "贴脸补一拳", "description_key": "active_bail_out.description", "description_text": "冲刺 [dash.distance] 厘米，[empower_basic.duration] 秒内下一次普攻多造成 [empower_basic.amount] 物理伤害。", "icon_id": "icon_active_bail_out"},
    {"id": "active_apology_slide", "namespace": "DemoContent", "name_key": "active_apology_slide.name", "name_text": "铲你脚脖子", "description_key": "active_apology_slide.description", "description_text": "滑铲 [dash.distance] 厘米，首个撞到的敌人受 [damage.amount] 物理伤害并减速 [slow.ratio]%，[slow.duration] 秒。", "icon_id": "icon_active_apology_slide"},
    {"id": "active_not_mad", "namespace": "DemoContent", "name_key": "active_not_mad.name", "name_text": "锅盖挡脸", "description_key": "active_not_mad.description", "description_text": "获得 [shield.amount] 护盾，持续 [shield.duration] 秒，并解除减速和定身。", "icon_id": "icon_active_not_mad"},
    {"id": "active_stare_down", "namespace": "DemoContent", "name_key": "active_stare_down.name", "name_text": "来打老子啊", "description_key": "active_stare_down.description", "description_text": "嘲讽身边对手 [taunt.duration] 秒，自己护甲和魔抗 +[timed_stat_bonus.ArmorFlat]，持续 [timed_stat_bonus.duration] 秒。", "icon_id": "icon_active_stare_down"},
    {"id": "active_triple_combo", "namespace": "DemoContent", "name_key": "active_triple_combo.name", "name_text": "左右开抽", "description_key": "active_triple_combo.description", "description_text": "接下来 [empower_basic.count] 次普攻攻速 +[empower_basic.AttackSpeedBonusRatio]%，各多造成 [empower_basic.amount] 物理伤害。", "icon_id": "icon_active_triple_combo"},
    {"id": "active_calculus_drop", "namespace": "DemoContent", "name_key": "active_calculus_drop.name", "name_text": "板砖糊脸", "description_key": "active_calculus_drop.description", "description_text": "板砖 [ground_impact.delay] 秒后砸下，中心 [damage.amount] 魔法伤害，外圈 [ground_impact.ratio]%。", "icon_id": "icon_active_calculus_drop"},
    {"id": "active_flyer_trap", "namespace": "DemoContent", "name_key": "active_flyer_trap.name", "name_text": "踩一脚试试", "description_key": "active_flyer_trap.description", "description_text": "放一张陷阱，保留 [contact_trap.duration] 秒；敌人踩近就炸，造成 [damage.amount] 魔法伤害并减速 [slow.ratio]%。限一张。", "icon_id": "icon_active_flyer_trap"},
    {"id": "active_open_mic", "namespace": "DemoContent", "name_key": "active_open_mic.name", "name_text": "扯嗓子喷你", "description_key": "active_open_mic.description", "description_text": "朝前喷 [channel_cone.count] 波，各造成 [damage.amount] 魔法伤害；末波减速 [channel_cone.secondary_ratio]%，[channel_cone.secondary_duration] 秒。可移动，换招中断。", "icon_id": "icon_active_open_mic"},
    {"id": "stat_physique", "namespace": "DemoContent", "name_key": "stat_physique.name", "name_text": "体格", "description_key": "stat_physique.description", "description_text": "每点最大生命 +[per_point.MaxHPFlat]、生命回复 +[per_point.HPRegenFlat]/秒。", "icon_id": "icon_stat_physique"},
    {"id": "stat_thick_skin", "namespace": "DemoContent", "name_key": "stat_thick_skin.name", "name_text": "脸皮", "description_key": "stat_thick_skin.description", "description_text": "每点护甲和魔抗各 +[per_point.ArmorFlat]。", "icon_id": "icon_stat_thick_skin"},
    {"id": "stat_strength", "namespace": "DemoContent", "name_key": "stat_strength.name", "name_text": "力道", "description_key": "stat_strength.description", "description_text": "每点攻击力 +[per_point.ADFlat]、暴击率 +[per_point.CritChanceBonusRatio]%。", "icon_id": "icon_stat_strength"},
    {"id": "stat_brains", "namespace": "DemoContent", "name_key": "stat_brains.name", "name_text": "脑力", "description_key": "stat_brains.description", "description_text": "每点法术强度 +[per_point.APFlat]、技能急速 +[per_point.CooldownHasteFlat]、法力回复 +[per_point.MPRegenFlat]/秒。", "icon_id": "icon_stat_brains"},
    {"id": "stat_agility", "namespace": "DemoContent", "name_key": "stat_agility.name", "name_text": "身手", "description_key": "stat_agility.description", "description_text": "每点攻速 +[per_point.AttackSpeedBonusRatio]%、移速 +[per_point.MoveSpeedBonusRatio]%。", "icon_id": "icon_stat_agility"},
    {"id": "attack_slowed", "namespace": "DemoContent", "name_key": "attack_slowed.name", "name_text": "攻速降低", "description_key": "attack_slowed.description", "description_text": "挥拳暂时变慢，不是缴械，仍可攻击和施法。", "icon_id": "icon_attack_slowed"},
    {"id": "knockback", "namespace": "DemoContent", "name_key": "knockback.name", "name_text": "击退", "description_key": "knockback.description", "description_text": "被一股力推出去：飞出去的这一小会儿不能移动、冲刺、普攻和放技能。", "icon_id": "icon_knockback"},
    {"id": "silence", "namespace": "DemoContent", "name_key": "silence.name", "name_text": "沉默", "description_key": "silence.description", "description_text": "号被封了：不能放技能，但仍可以移动、冲刺和普攻；正在准备的技能会被打断。", "icon_id": "icon_silence"},
    {"id": "burn", "namespace": "DemoContent", "name_key": "burn.name", "name_text": "灼烧", "description_key": "burn.description", "description_text": "身上着火了：持续受到魔法伤害，层数越多烧得越疼；新叠一层会刷新时间。", "icon_id": "icon_burn"},
    {"id": "monster_scavenger", "namespace": "DemoContent", "name_key": "monster_scavenger.name", "name_text": "已读不回的 HR", "description_key": "monster_scavenger.description", "description_text": "两只一组的小野怪：不主动理你，你一打她俩一起回你；追得太远就回位。", "icon_id": "icon_monster_scavenger"},
    {"id": "monster_guardian", "namespace": "DemoContent", "name_key": "monster_guardian.name", "name_text": "追着办卡的私教", "description_key": "monster_guardian.description", "description_text": "更耐打、出手更重的大野怪，一拳一个办卡：不会主动出手，被打后反击；追得太远就回位。", "icon_id": "icon_monster_guardian"},
    {"id": "monster_advisor", "namespace": "DemoContent", "name_key": "monster_advisor.name", "name_text": "催毕设的导师", "description_key": "monster_advisor.description", "description_text": "守在外圈高台的最强野怪，血厚手重：不会主动出手，被打后反击；追得太远就回位。", "icon_id": "icon_monster_advisor"},
    {"id": "monster_dean", "namespace": "DemoContent", "name_key": "monster_dean.name", "name_text": "画饼老板", "description_key": "monster_dean.description", "description_text": "开局一分钟后出现，沿四个公开巡逻点巡逻。谁打它就追谁，否则打身边最近的人。全场只有一次，最后一击的人“吃到大饼”。", "icon_id": "icon_monster_dean"},
    {"id": "root", "namespace": "DemoContent", "name_key": "root.name", "name_text": "定身", "description_key": "root.description", "description_text": "裤子被扒了，忙着提：不能移动和冲刺，但仍可以普攻和放技能。", "icon_id": "icon_root"},
    {"id": "shield", "namespace": "DemoContent", "name_key": "shield.name", "name_text": "护盾", "description_key": "shield.description", "description_text": "先替你挡下伤害，被打穿或到时间就没了。", "icon_id": "icon_shield"},
    {"id": "camp_returning", "namespace": "DemoContent", "name_key": "camp_returning.name", "name_text": "回位", "description_key": "camp_returning.description", "description_text": "野怪正在回位，途中不攻击也不换目标，但仍会挨打；回到原位后生命回满。", "icon_id": "icon_camp_returning"},
    {"id": "respawn_protection", "namespace": "DemoContent", "name_key": "respawn_protection.name", "name_text": "复活保护", "description_key": "respawn_protection.description", "description_text": "刚从出租屋回来，暂时不受伤害和控制；一出手就没了，失手也没了。复活保护期间不能争旗杆。", "icon_id": "icon_respawn_protection"},
    {"id": "slow", "namespace": "DemoContent", "name_key": "slow.name", "name_text": "减速", "description_key": "slow.description", "description_text": "移速暂时降低，到时间就恢复；同时中了好几次减速，只按最狠的那次算。", "icon_id": "icon_slow"},
    {"id": "stat_boost", "namespace": "DemoContent", "name_key": "stat_boost.name", "name_text": "增益", "description_key": "stat_boost.description", "description_text": "技能带来的属性提升，到时间就消失。", "icon_id": "icon_stat_boost"},
    {"id": "exposed", "namespace": "DemoContent", "name_key": "exposed.name", "name_text": "破防", "description_key": "exposed.description", "description_text": "护甲或魔抗被削了：一段时间内受到的物理伤害或魔法伤害更高。", "icon_id": "icon_exposed"},
    {"id": "taunt", "namespace": "DemoContent", "name_key": "taunt.name", "name_text": "嘲讽", "description_key": "taunt.description", "description_text": "被激到了：只能追着冲你喊「来打老子啊」的人普攻，不能放技能、冲刺或自己下令；对方寄了、离开或不在视野里时立刻解除。", "icon_id": "icon_taunt"},
    {"id": "disarm", "namespace": "DemoContent", "name_key": "disarm.name", "name_text": "缴械", "description_key": "disarm.description", "description_text": "两只手忙着护裆：无法普攻，但仍可以移动、冲刺和放技能。", "icon_id": "icon_disarm"},
    {"id": "stun", "namespace": "DemoContent", "name_key": "stun.name", "name_text": "眩晕", "description_key": "stun.description", "description_text": "脑子转不动了：不能移动、冲刺、普攻和放技能；正在准备的动作会被打断。", "icon_id": "icon_stun"},
    {"id": "empowered", "namespace": "DemoContent", "name_key": "empowered.name", "name_text": "强化普攻", "description_key": "empowered.description", "description_text": "下一次打中敌人的普攻额外造成伤害；打出或到时间就没了。", "icon_id": "icon_empowered"}
  ]
}
