  "display": [
    {"id": "character_demo", "namespace": "DemoContent", "name_key": "character_demo.name", "name_text": "大一新生", "description_key": "character_demo.description", "description_text": "已成年的大一新生。开局只会弹脑瓜崩，升级后挑选技能或属性奖励，也能去小卖部买装备。", "icon_id": "icon_character_demo", "portrait_icon_id": "portrait_character_demo"},
    {"id": "active_arc_bolt", "namespace": "DemoContent", "name_key": "active_arc_bolt.name", "name_text": "粉笔头", "description_key": "active_arc_bolt.description", "description_text": "朝指定方向扔出粉笔头，直线飞行，碰到第一个敌人或障碍就停下，对敌人造成皮肉伤，不会正中要害。", "icon_id": "icon_active_arc_bolt"},
    {"id": "active_guard_pulse", "namespace": "DemoContent", "name_key": "active_guard_pulse.name", "name_text": "假装无事发生", "description_key": "active_guard_pulse.description", "description_text": "给自己加上淡定，并立刻解除身上所有定身。淡定量随缺德值提高。", "icon_id": "icon_active_guard_pulse"},
    {"id": "active_binding_snare", "namespace": "DemoContent", "name_key": "active_binding_snare.name", "name_text": "扒裤衩", "description_key": "active_binding_snare.description", "description_text": "对一名看得见的敌人造成社死伤害并让其定身。伤害随缺德值提高，不会正中要害。", "icon_id": "icon_active_binding_snare"},
    {"id": "passive_battle_rhythm", "namespace": "DemoContent", "name_key": "passive_battle_rhythm.name", "name_text": "单身二十年的手速", "description_key": "passive_battle_rhythm.description", "description_text": "学会后持续提高手速。", "icon_id": "icon_passive_battle_rhythm"},
    {"id": "passive_second_wind", "namespace": "DemoContent", "name_key": "passive_second_wind.name", "name_text": "多喝热水", "description_key": "passive_second_wind.description", "description_text": "脱离战斗一段时间后，额外提高面子回复；一进入战斗，额外回复立刻停止。", "icon_id": "icon_passive_second_wind"},
    {"id": "passive_precision", "namespace": "DemoContent", "name_key": "passive_precision.name", "name_text": "正中要害", "description_key": "passive_precision.description", "description_text": "学会后提高弹脑瓜崩的正中要害率，对技能无效。", "icon_id": "icon_passive_precision"},
    {"id": "active_slipper_throw", "namespace": "DemoContent", "name_key": "active_slipper_throw.name", "name_text": "老妈的拖鞋", "description_key": "active_slipper_throw.description", "description_text": "朝一名看得见的敌人甩出拖鞋，必定命中，造成皮肉伤并让其减速。伤害随手劲提高，不会正中要害。", "icon_id": "icon_active_slipper_throw"},
    {"id": "active_fart_dash", "namespace": "DemoContent", "name_key": "active_fart_dash.name", "name_text": "屁遁", "description_key": "active_fart_dash.description", "description_text": "朝指定方向冲出一段距离，同时在出发点放个屁：周围的敌人受到社死伤害并减速。伤害随手劲和缺德值提高；被定身时不能使用。", "icon_id": "icon_active_fart_dash"},
    {"id": "active_combo_flurry", "namespace": "DemoContent", "name_key": "active_combo_flurry.name", "name_text": "夺命连环掏", "description_key": "active_combo_flurry.description", "description_text": "短时间内大幅提高手速。", "icon_id": "icon_active_combo_flurry"},
    {"id": "active_slick_moves", "namespace": "DemoContent", "name_key": "active_slick_moves.name", "name_text": "风骚走位", "description_key": "active_slick_moves.description", "description_text": "短时间内大幅提高腿速。", "icon_id": "icon_active_slick_moves"},
    {"id": "passive_cornered", "namespace": "DemoContent", "name_key": "passive_cornered.name", "name_text": "急了", "description_key": "passive_cornered.description", "description_text": "面子低于一定比例时，手劲按比例提高；面子回升后恢复。", "icon_id": "icon_passive_cornered"},
    {"id": "passive_lurking", "namespace": "DemoContent", "name_key": "passive_lurking.name", "name_text": "暗中观察", "description_key": "passive_lurking.description", "description_text": "脱离战斗一段时间后，下一次弹脑瓜崩或伤害技能额外造成社死伤害。伤害随手劲和缺德值提高。", "icon_id": "icon_passive_lurking"},
    {"id": "passive_public_shame", "namespace": "DemoContent", "name_key": "passive_public_shame.name", "name_text": "社死现场", "description_key": "passive_public_shame.description", "description_text": "被你定身的敌人，之后一段时间内受到你的伤害提高。", "icon_id": "icon_passive_public_shame"},
    {"id": "passive_eagle_eye", "namespace": "DemoContent", "name_key": "passive_eagle_eye.name", "name_text": "视力5.0", "description_key": "passive_eagle_eye.description", "description_text": "学会后提高弹脑瓜崩的攻击距离。", "icon_id": "icon_passive_eagle_eye"},
    {"id": "active_monkey_peach", "namespace": "DemoContent", "name_key": "active_monkey_peach.name", "name_text": "猴子偷桃", "description_key": "active_monkey_peach.description", "description_text": "对身边一名看得见的敌人造成皮肉伤并让其缴械：期间不能弹脑瓜崩，仍可移动、放技能和用装备。伤害随手劲提高，不会正中要害。", "icon_id": "icon_active_monkey_peach"},
    {"id": "active_thousand_year", "namespace": "DemoContent", "name_key": "active_thousand_year.name", "name_text": "千年杀", "description_key": "active_thousand_year.description", "description_text": "对贴身的一名看得见的敌人造成社死伤害，伤害随手劲和缺德值提高，不会正中要害。从对方背后出手时伤害更高，并让对方原地起飞、眩晕。", "icon_id": "icon_active_thousand_year"},
    {"id": "active_lunge", "namespace": "DemoContent", "name_key": "active_lunge.name", "name_text": "一个箭步", "description_key": "active_lunge.description", "description_text": "朝指定方向冲出一段距离，碰到阻挡就停下；之后一段时间内的下一次弹脑瓜崩额外造成皮肉伤。被定身时不能冲刺。", "icon_id": "icon_active_lunge"},
    {"id": "active_body_slam", "namespace": "DemoContent", "name_key": "active_body_slam.name", "name_text": "泰山压顶", "description_key": "active_body_slam.description", "description_text": "跳向指定地点，落地时对周围的敌人造成皮肉伤并减速。伤害随手劲提高，不会正中要害。被定身时不能起跳。", "icon_id": "icon_active_body_slam"},
    {"id": "active_come_here", "namespace": "DemoContent", "name_key": "active_come_here.name", "name_text": "你过来啊", "description_key": "active_come_here.description", "description_text": "嘲讽身边看得见你的敌人：他们只能追着你弹脑瓜崩，不能放技能、用装备或冲刺；同时短时间内提高自己的抗揍和脸皮。", "icon_id": "icon_active_come_here"},
    {"id": "passive_iron_crotch", "namespace": "DemoContent", "name_key": "passive_iron_crotch.name", "name_text": "铁裆功", "description_key": "passive_iron_crotch.description", "description_text": "被近处敌人的弹脑瓜崩或技能打中时，让对方受到社死伤害，随抗揍提高，被正中要害时翻倍。背后来袭不触发，同一人短时间内只触发一次。", "icon_id": "icon_passive_iron_crotch"},
    {"id": "attr_might", "namespace": "DemoContent", "name_key": "attr_might.name", "name_text": "举铁", "description_key": "attr_might.description", "description_text": "本局永久提高手劲。", "icon_id": "icon_attr_might"},
