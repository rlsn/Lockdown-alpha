{
  "schema": 1,
  "purpose": "Every third-party asset source of the project (VFX, animation, audio, UI, art) and its rights as separate dimensions. Domain manifests keep their own file-level records; this file links to them.",
  "rules": [
    "AI input permission never implies public redistribution.",
    "Assets with public_source_redistribution 'no' (and any adapted asset containing their content) are storage 'local-only': under Content/ThirdParty/Fab (git-ignored), installed into each worktree by Scripts/ThirdPartyAssets.py link from LD_THIRDPARTY_ROOT.",
    "CC0 and CC-BY assets may be tracked; CC-BY keeps its attribution and a record of modifications; none are relicensed under the project's code license.",
    "NO_AI (ai_input forbidden): integrated only by deterministic scripts; their content and derived pixels are never sent to a generative AI model; never used for training."
  ],
  "local_store": {
    "env": "LD_THIRDPARTY_ROOT",
    "layout": "<root>/Fab/<pack folder> is linked to Content/ThirdParty/Fab/<pack folder>"
