{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Demo world author contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projection_revision", "map_id", "layout_revision", "geometry_revision", "approval", "coordinate_unit", "geometry", "placement", "parameter_refs", "anchors"],
  "properties": {
    "schema_version": {"type": "integer", "const": 3},
    "projection_revision": {"type": "integer", "const": 3},
    "map_id": {"$ref": "#/$defs/id"},
    "layout_revision": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "geometry_revision": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "coordinate_unit": {"type": "string", "const": "cm"},
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["status", "decision"],
      "properties": {
        "status": {"type": "string", "const": "approved"},
        "decision": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": ".*\\S.*"}
      }
    },
    "geometry": {
      "type": "object", "additionalProperties": false,
      "required": ["surfaces", "elevation", "blockers", "sight_sample_height_cm", "camp_clearance_cm"],
      "properties": {
        "surfaces": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "min_cm", "max_cm"],
            "properties": {"id": {"$ref": "#/$defs/id"}, "min_cm": {"$ref": "#/$defs/vector"}, "max_cm": {"$ref": "#/$defs/vector"}}
          }
        },
        "elevation": {
          "type": "object", "additionalProperties": false, "required": ["level_step_cm", "plateaus", "ramps"],
          "properties": {
            "level_step_cm": {"$ref": "#/$defs/positive_cm"},
            "plateaus": {
              "type": "array", "minItems": 0, "maxItems": 64,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["id", "level", "polygon_cm"],
                "properties": {
                  "id": {"$ref": "#/$defs/id"}, "level": {"type": "integer", "minimum": 1, "maximum": 2},
                  "polygon_cm": {"type": "array", "minItems": 3, "maxItems": 16, "items": {"$ref": "#/$defs/vector"}}
                }
              }
            },
            "ramps": {
              "type": "array", "minItems": 0, "maxItems": 64,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["id", "lower_level", "polygon_cm"],
                "properties": {
                  "id": {"$ref": "#/$defs/id"}, "lower_level": {"type": "integer", "minimum": 0, "maximum": 1},
                  "polygon_cm": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/vector"}}
                }
              }
            }
          }
        },
        "blockers": {"type": "array", "minItems": 4, "maxItems": 2048, "items": {"$ref": "#/$defs/blocker"}},
        "sight_sample_height_cm": {"$ref": "#/$defs/positive_cm"},
        "camp_clearance_cm": {"$ref": "#/$defs/positive_cm"}
      }
    },
    "placement": {
      "type": "object", "additionalProperties": false,
      "required": ["spawn_offsets_cm", "spawn_validation_radius_cm"],
      "properties": {
        "spawn_offsets_cm": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/vector"}},
        "spawn_validation_radius_cm": {"$ref": "#/$defs/positive_cm"}
      }
    },
    "parameter_refs": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "string",
        "enum": [
          "AIRDROP.PickupRadiusCm", "CAMP.ResetArrivalRadiusCm", "CAPTURE.RadiusCm", "DORM.RadiusCm",
          "UNIT.BasicAttackRangeCm", "UNIT.CollisionRadiusCm", "VISION.RadiusCm"
        ]
      }
    },
    "anchors": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/anchor"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z][a-z0-9_]*$"},
    "coordinate": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
    "positive_cm": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "vector": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "z"],
      "properties": {"x": {"$ref": "#/$defs/coordinate"}, "y": {"$ref": "#/$defs/coordinate"}, "z": {"$ref": "#/$defs/coordinate"}}
    },
    "blocker": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "surface_id", "shape", "polygon_cm", "height_cm", "blocks_movement", "blocks_sight"],
          "properties": {
            "id": {"$ref": "#/$defs/id"}, "surface_id": {"$ref": "#/$defs/id"}, "shape": {"type": "string", "const": "polygon"},
            "polygon_cm": {"type": "array", "minItems": 3, "maxItems": 16, "items": {"$ref": "#/$defs/vector"}},
            "height_cm": {"$ref": "#/$defs/positive_cm"},
            "blocks_movement": {"type": "boolean"}, "blocks_sight": {"type": "boolean"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "surface_id", "shape", "center_cm", "radius_cm", "height_cm", "blocks_movement", "blocks_sight"],
          "properties": {
            "id": {"$ref": "#/$defs/id"}, "surface_id": {"$ref": "#/$defs/id"}, "shape": {"type": "string", "const": "cylinder"},
            "center_cm": {"$ref": "#/$defs/vector"}, "radius_cm": {"$ref": "#/$defs/positive_cm"},
            "height_cm": {"$ref": "#/$defs/positive_cm"},
            "blocks_movement": {"type": "boolean"}, "blocks_sight": {"type": "boolean"}
          }
        }
      ]
    },
    "anchor": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["id", "kind", "surface_id", "position_cm"],
          "properties": {
            "id": {"$ref": "#/$defs/id"}, "kind": {"type": "string", "enum": ["Spawn", "Capture", "Dorm", "Airdrop", "BossWaypoint", "PKSpawn", "PKThrow", "PKSignup", "RestSpawn", "RestService"]},
            "surface_id": {"$ref": "#/$defs/id"}, "position_cm": {"$ref": "#/$defs/vector"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["id", "kind", "surface_id", "position_cm", "members"],
          "properties": {
            "id": {"$ref": "#/$defs/id"}, "kind": {"type": "string", "const": "Camp"},
            "surface_id": {"$ref": "#/$defs/id"}, "position_cm": {"$ref": "#/$defs/vector"},
            "members": {
              "type": "array", "minItems": 1, "maxItems": 2,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["id", "position_cm"],
                "properties": {"id": {"$ref": "#/$defs/id"}, "position_cm": {"$ref": "#/$defs/vector"}}
              }
            }
          }
        }
      ]
    }
  }
}
